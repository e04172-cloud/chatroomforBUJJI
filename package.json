{
  "name": "budae-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/configure.mjs --test && npx firebase emulators:exec --only firestore,database \"vitest run tests/rules\"",
    "test:int": "echo \"defined in a later task\" && exit 1",
    "test:e2e": "echo \"defined in a later task\" && exit 1",
    "emulators": "npx firebase emulators:start --only auth,firestore,database,hosting"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@playwright/test": "1.48.2",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "firebase-tools": "13.35.1",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
