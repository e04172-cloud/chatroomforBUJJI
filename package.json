{
  "name": "budae-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run tests/unit",
    "test:rules": "echo \"defined in Task 5\" && exit 1",
    "test:int": "echo \"defined in a later task\" && exit 1",
    "test:e2e": "echo \"defined in a later task\" && exit 1",
    "emulators": "npx firebase emulators:start --only auth,firestore,database,hosting"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
